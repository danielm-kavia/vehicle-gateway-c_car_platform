# Vehicle Gateway (stub)

PORT=3004
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=vehicle-gateway

# Shared Kafka config (used by telematics publisher + remote commands)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=vehicle-gateway

# --- Phase 3: Telematics publisher (optional) ---
TELEMATICS_PUBLISH_ENABLED=false
TELEMATICS_PUBLISH_MODE=kafka
KAFKA_TOPIC_TELEMATICS=telematics.v1

# HTTP fallback publishing to telematics-ingestion
TELEMATICS_INGESTION_HTTP_URL=http://localhost:3002/v1/telematics/batch
TELEMATICS_INGESTION_AUTH_TOKEN=

# --- Phase 6: Remote Commands (optional) ---
RC_ENABLED=true

# Prefer Kafka if enabled; else gateway will rely on HTTP callback to remote-commands service
RC_USE_KAFKA=false

# Topics (Phase 6)
KAFKA_TOPIC_REMOTE_COMMAND=remote-command.v1
KAFKA_TOPIC_COMMAND_ACK=command-ack.v1
KAFKA_CONSUMER_GROUP_ID_REMOTE_COMMANDS=vehicle-gateway-remote-commands-v1

# Remote-commands HTTP callback base URL (used when RC_USE_KAFKA=false or Kafka is down)
RC_REMOTE_COMMANDS_HTTP_URL=http://localhost:3020
