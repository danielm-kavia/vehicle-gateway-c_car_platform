BACKEND_URL=http://localhost:3004
FRONTEND_URL=http://localhost:3000
WS_URL=ws://localhost:3004/ws
SITE_URL=http://localhost:3000

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_MAX_AGE=3600

COOKIE_DOMAIN=localhost
TRUST_PROXY=true
HOST=0.0.0.0
NODE_ENV=development

REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=100

PORT=3004

# Logging
SERVICE_NAME=vehicle-gateway
LOG_LEVEL=info

# --- Phase 3: optional telematics publisher stub ---
# When enabled, gateway exposes POST /v1/dev/telematics/publish and forwards payload to Kafka or ingestion HTTP.
TELEMATICS_PUBLISH_ENABLED=false
# kafka | http
TELEMATICS_PUBLISH_MODE=kafka
TELEMATICS_DEFAULT_DEVICE_ID=sim-device

# Kafka publish config
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=vehicle-gateway
KAFKA_TOPIC_TELEMATICS=telematics.v1

# HTTP fallback config (when TELEMATICS_PUBLISH_MODE=http)
TELEMATICS_INGESTION_HTTP_URL=http://localhost:3002/v1/telematics/batch
# Optional: if ingestion endpoint requires Bearer auth
TELEMATICS_INGESTION_AUTH_TOKEN=
